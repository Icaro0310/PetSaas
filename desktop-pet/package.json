{
  "name": "petdesksaas",
  "version": "0.1.0",
  "description": "PetDeskSaas - desktop pet companion for PetSaas (Windows)",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/preload','dist/preload',{recursive:true});fs.cpSync('src/renderer','dist/renderer',{recursive:true})\"",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.petsaas.petdesk",
    "productName": "PetDeskSaas",
    "files": [
      "dist/**",
      "pets/builtin/**",
      "mcp/**",
      "!pets/builtin-src/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "pets/builtin/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "PetDeskSaas-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/yauzl": "^3.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
