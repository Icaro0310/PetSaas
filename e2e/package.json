{
  "name": "petcare-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Cypress (suite principal) + Playwright (fallback) E2E/UAT para o website, app Flutter Web e Edge Functions do PetCare",
  "scripts": {
    "test": "node scripts/cypress.js run",
    "test:headed": "node scripts/cypress.js run --headed",
    "test:open": "node scripts/cypress.js open",
    "test:app": "node scripts/cypress.js run --spec \"cypress/e2e/app/**/*.cy.ts\"",
    "test:fallback": "playwright test",
    "test:all": "node scripts/cypress.js run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cypress": "^16.1.0",
    "cypress-real-events": "^1.15.1",
    "typescript": "^7.0.2"
  }
}
